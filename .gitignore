# Swift build artifacts
SwiftExtension/.build/

# Compiled extension library
GodotProject/bin/*.dylib
GodotProject/bin/*.so
GodotProject/bin/*.dll

# Godot editor metadata. Keep the minimal extension list tracked so Godot
# reliably loads the GDExtension from a clean checkout or scaffolded project.
GodotProject/.godot/*
!GodotProject/.godot/.gdignore
!GodotProject/.godot/extension_list.cfg

*.xcuserstate
